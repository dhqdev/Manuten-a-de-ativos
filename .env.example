# --- Supabase (chaves públicas, podem ir para o navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Endereço público do app ---
# Usado nos links de confirmação de e-mail e redefinição de senha.
# Em desenvolvimento pode deixar vazio. Em produção: https://seu-dominio.com
NEXT_PUBLIC_SITE_URL=

# --- Chave secreta: NUNCA com prefixo NEXT_PUBLIC_ ---
# Ignora o RLS. Só para scripts administrativos no servidor.
SUPABASE_SECRET_KEY=

# --- Opcional, só em desenvolvimento ---
# Origens extras liberadas para o hot-reload (túneis, outro domínio local).
# DEV_ORIGINS=meu-tunel.trycloudflare.com
