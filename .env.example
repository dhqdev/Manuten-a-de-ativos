# --- Supabase (chaves públicas, podem ir para o navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Endereço público do app ---
# Usado nos links de confirmação de e-mail, redefinição de senha e nas
# mensagens do WhatsApp. Em produção: https://seu-dominio.com
NEXT_PUBLIC_SITE_URL=

# ============================================================================
#  Daqui para baixo: SOMENTE SERVIDOR. Nada de prefixo NEXT_PUBLIC_.
# ============================================================================

# Ignora o RLS. Usada só pela rotina diária de notificações,
# que precisa varrer todas as empresas.
SUPABASE_SECRET_KEY=

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=https://zap.tekvosoft.com
EVOLUTION_API_KEY=

# Protege GET /api/notificacoes/disparar.
# A Vercel envia este valor automaticamente no cron.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Opcional, só em desenvolvimento ---
# Origens extras liberadas para o hot-reload (túneis, outro domínio local).
# DEV_ORIGINS=meu-tunel.trycloudflare.com
